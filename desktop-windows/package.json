{
  "name": "worklog-windows",
  "version": "0.2.1",
  "description": "WorkLog para Windows: controle de horas com painel estilo notch no topo da tela.",
  "homepage": "https://github.com/Ribeiro-Murilo/WorkLog",
  "author": {
    "name": "Murilo Ribeiro",
    "email": "94489042+Ribeiro-Murilo@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "dev:electron": "wait-on tcp:127.0.0.1:5180 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5180 electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win --x64 --dir -c.win.signAndEditExecutable=false",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.ribeiroworkes.worklog",
    "productName": "WorkLog",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/icon.png"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WorkLog",
      "artifactName": "WorkLog-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WorkLog-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  }
}
