  "narrative": {
    "northStar": "The Camera-Integrated Session Panel",
    "overview": "The approved notch world joins an opaque black session panel to the physical screen edge. Restrained gray text, native SF typography and small project identifiers keep the session and its controls readable in a compact surface.\n\nThis document governs the notch panel only. Dashboard, other application screens and the menu bar retain their incumbent UI; these rules do not mandate an application-wide rebrand. Measurements describe native SwiftUI/AppKit points, not CSS implementation. The source is authoritative; the sidecar includes illustrative browser translations for the design panel.",
    "keyCharacteristics": [
      "Opaque camera-integrated silhouette with concave shoulders.",
      "A large monospaced session timer and clear primary action.",
      "Compact project rows, bounded scrolling and a visible utility footer."
    ],
    "rules": [
      {
        "name": "The Camera Clearance Rule",
        "body": "Keep the expanded content below the physical camera height; the black silhouette begins at the physical screen edge.",
        "section": "layout"
      },
      {
        "name": "The Session Hierarchy Rule",
        "body": "Reserve the prominent light button for the current session’s main action; project colors identify projects.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve physical camera clearance and the complete concave shoulders.",
      "Do keep the daily total and footer outside the bounded project scroll area.",
      "Do use the native system font and monospaced timer design in this macOS surface.",
      "Do preserve project identity colors consistently across launches and devices."
    ],
    "donts": [
      "Don’t replace the opaque camera-integrated background with translucent material.",
      "Don’t stretch the panel to accommodate long project names; truncate names and expose their full value through help.",
      "Don’t apply this notch-only system to other application screens without a separate design decision."
    ]
  }
